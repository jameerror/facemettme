# Copy to .env; the app opens directly without login or a password.
# Bare domain/IP, comma separated. Loopback names are needed for Docker healthchecks/SSH.
FACE_SWAP_TRUSTED_HOSTS=127.0.0.1,localhost
FACE_SWAP_MAX_UPLOAD_MB=5120
# Only needed for the optional HTTPS profile; DNS must point to your server.
FACE_SWAP_DOMAIN=swap.example.com
